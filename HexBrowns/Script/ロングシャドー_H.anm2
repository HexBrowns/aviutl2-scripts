--information:ロングシャドー_H v2.3.1 by HexBrowns
--label:HexScript
--filter

--group:シャドウ
--track@length:長さ,0,4000,200,1
--track@angle:角度,-1280,1280,0,1
--track@alpha:不透明度,0,1,1,0.01
--color@color_start:開始色,0xffffff
--check@use_grad:グラデーション,1
--color@color_end:終了色,0x000000
--select@color_space:色空間=0,sRGB=0,リニア=1,Oklab=2,HSV=3,HSL=4,Lab=5,LCh=6,Oklch=7,HWB=9
--hide@color_space:use_grad==0
--select@hue_path:色相経路=0,短経路=0,長経路=1
--hide@hue_path:use_grad==0
--hide@hue_path:color_space<3
--hide@hue_path:color_space==5
--check@fade_by_dist:距離で透明,0

--group:拡散・収束
--track@edge_top:上辺,-80,80,0,0.1
--track@edge_bottom:下辺,-80,80,0,0.1
--check@edge_symmetric:角度対称,0

--group:エッジぼかし
--track@blur:ぼかし,0,100,0,0.01
--select@blur_dist:分布=1,矩形分布=0,三角分布=1,ガウス分布=2

--group:オプション
--check@shadow_only:影のみ,0
--check@fix_rotate:回転を補正,1
--check@flat:フラット,0
--group:

--[[pixelshader@ps_longshadow:
Texture2D InputTexture : register(t0);

cbuffer constant0 : register(b0) {
    float l;
    float alpha;
    float trp;
    float mode;
    float2 dir;
    float2 n;
    float2 center;
    float half_w;
    float ns;
    float nphi;
    float edge_a;
    float edge_b;
    float tex_w;
    float tex_h;
    float _pad0;
    float3 c1;
    float _pad1;
    float3 c2;
    float _pad2;
    float cs_space;   // 28  色空間（0 sRGB = v2.2 までと同じ lerp。それ以外は c1 / c2 がその色空間の値）
    float hue_long;   // 29  色相経路（1 で長い方を回る）
};

// ==== colorspace.hlsl ここから（AI/tools/sync_colorspace.py が書き写す。直すのは正本） ====
// colorspace.hlsl v1.01 — 色空間の変換・補間・色相回転・色差（HexBrowns）
// 正本: AI/tools/assets/colorspace.hlsl。各スクリプトの印の間へは AI/tools/sync_colorspace.py が書き写す（写しを直さない）
// Lua 側の同じ式: Script/EffectUtils_ColorSpace.lua。机上検証: AI/scripts/色空間拡張/verify_colorspace.py
//
// 色はすべてストレート（乗算済みでない）の sRGB（0〜1）で受け渡す。
// 色空間の番号（全スクリプト共通。@図形グラデーション_H と同じ）
//   0 sRGB / 1 リニア / 2 Oklab / 3 HSV / 4 HSL / 5 Lab / 6 LCh / 7 Oklch / 8 XYZ / 9 HWB
// 色相のある色空間（3 / 4 / 6 / 7 / 9）は x に色相（0〜1 周）を置く。
//   HSV (h, s, v) / HSL (h, s, l) / HWB (h, w, b) / LCh (h, C, L) / Oklch (h, C, L)
// Lab は D65 の白（XYZ を経由。CSS の lab() は D50 なので値は少し違う）。
// 色差の種類: 0 RGB / 1 YCbCr（色差だけ。明るさを見ない）/ 2 Oklab / 3 CIEDE2000。
//   どれも黒と白の差がおよそ 1 になるように割ってある（YCbCr は明るさを見ないので黒と白は 0）

#define CS_TAU 6.28318530717958647692

float cs_lin1(float c) {
    return c <= 0.04045 ? c / 12.92 : pow(abs((c + 0.055) / 1.055), 2.4);
}

float cs_srgb1(float c) {
    return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(abs(c), 1.0 / 2.4) - 0.055;
}

float3 cs_to_linear(float3 c) {
    return float3(cs_lin1(c.r), cs_lin1(c.g), cs_lin1(c.b));
}

// リニア → sRGB。範囲外は切り詰める
float3 cs_to_srgb(float3 c) {
    float3 s = saturate(c);
    return float3(cs_srgb1(s.r), cs_srgb1(s.g), cs_srgb1(s.b));
}

float cs_cbrt(float x) {
    return sign(x) * pow(abs(x), 1.0 / 3.0);
}

// Oklab（Björn Ottosson, 2020）
float3 cs_linear_to_oklab(float3 c) {
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = cs_cbrt(l);
    float m_ = cs_cbrt(m);
    float s_ = cs_cbrt(s);
    return float3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_);
}

float3 cs_oklab_to_linear(float3 c) {
    float l_ = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
    float m_ = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
    float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return float3(
         4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

// sRGB（D65）のリニア ⇔ XYZ（IEC 61966-2-1）
float3 cs_linear_to_xyz(float3 c) {
    return float3(
        0.4124564 * c.r + 0.3575761 * c.g + 0.1804375 * c.b,
        0.2126729 * c.r + 0.7151522 * c.g + 0.0721750 * c.b,
        0.0193339 * c.r + 0.1191920 * c.g + 0.9503041 * c.b);
}

float3 cs_xyz_to_linear(float3 c) {
    return float3(
         3.2404542 * c.x - 1.5371385 * c.y - 0.4985314 * c.z,
        -0.9692660 * c.x + 1.8760108 * c.y + 0.0415560 * c.z,
         0.0556434 * c.x - 0.2040259 * c.y + 1.0572252 * c.z);
}

// CIE 15: ε = 216/24389、κ = 24389/27
float cs_lab_f(float t) {
    return t > 0.008856452 ? cs_cbrt(t) : (903.2963 * t + 16.0) / 116.0;
}

float cs_lab_finv(float f) {
    float f3 = f * f * f;
    return f3 > 0.008856452 ? f3 : (116.0 * f - 16.0) / 903.2963;
}

float3 cs_xyz_to_lab(float3 c) {
    float fx = cs_lab_f(c.x / 0.95047);
    float fy = cs_lab_f(c.y);
    float fz = cs_lab_f(c.z / 1.08883);
    return float3(116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz));
}

float3 cs_lab_to_xyz(float3 c) {
    float fy = (c.x + 16.0) / 116.0;
    float fx = fy + c.y / 500.0;
    float fz = fy - c.z / 200.0;
    return float3(cs_lab_finv(fx) * 0.95047, cs_lab_finv(fy), cs_lab_finv(fz) * 1.08883);
}

// (L, a, b) → (色相 0〜1 周, C, L)
float3 cs_lab_to_polar(float3 v) {
    return float3(frac(atan2(v.z, v.y) / CS_TAU + 1.0), length(float2(v.y, v.z)), v.x);
}

float3 cs_polar_to_lab(float3 p) {
    return float3(p.z, p.y * cos(p.x * CS_TAU), p.y * sin(p.x * CS_TAU));
}

float cs_hue_of(float3 c, float mx, float mn) {
    float d = mx - mn;
    float h = 0.0;
    if (d > 0.000001) {
        if (mx == c.r) {
            h = (c.g - c.b) / d;
        } else if (mx == c.g) {
            h = (c.b - c.r) / d + 2.0;
        } else {
            h = (c.r - c.g) / d + 4.0;
        }
    }
    return frac(h / 6.0 + 1.0);
}

float3 cs_hue_rgb(float h) {
    float3 p = abs(frac(float3(h, h, h) + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return saturate(p - 1.0);
}

float3 cs_rgb_to_hsv(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float s = mx > 0.000001 ? (mx - mn) / mx : 0.0;
    return float3(cs_hue_of(c, mx, mn), s, mx);
}

float3 cs_hsv_to_rgb(float3 c) {
    return c.z * lerp(float3(1.0, 1.0, 1.0), cs_hue_rgb(c.x), saturate(c.y));
}

float3 cs_rgb_to_hsl(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float l = (mx + mn) * 0.5;
    float den = 1.0 - abs(2.0 * l - 1.0);
    float s = den > 0.000001 ? (mx - mn) / den : 0.0;
    return float3(cs_hue_of(c, mx, mn), s, l);
}

float3 cs_hsl_to_rgb(float3 c) {
    float chroma = (1.0 - abs(2.0 * c.z - 1.0)) * saturate(c.y);
    return (cs_hue_rgb(c.x) - 0.5) * chroma + c.z;
}

float3 cs_rgb_to_hwb(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    return float3(cs_hue_of(c, mx, mn), mn, 1.0 - mx);
}

float3 cs_hwb_to_rgb(float3 c) {
    float w = max(c.y, 0.0);
    float b = max(c.z, 0.0);
    float sum = w + b;
    if (sum > 1.0) {
        w = w / sum;
        b = b / sum;
    }
    return cs_hue_rgb(c.x) * (1.0 - w - b) + w;
}

// リニアが sRGB の範囲に入っているか。float32 の誤差の分だけ、値の大きさに比例して許す
// （決まった幅で許すと、値の小さい暗い色で切り詰めたときに色相がずれる）
bool cs_in_gamut(float3 lin) {
    float e = max(abs(lin.r), max(abs(lin.g), abs(lin.b))) * 0.000002 + 0.000000001;
    return all(lin >= -e) && all(lin <= 1.0 + e);
}

// Oklch (h, C, L) をリニアへ。sRGB に無い色は、明るさと色相を保ったまま C を下げて収める（二分探索 16 回）
float3 cs_oklch_to_linear_fit(float3 p) {
    float3 lab = cs_polar_to_lab(p);
    float3 lin = cs_oklab_to_linear(lab);
    if (!cs_in_gamut(lin)) {
        float lo = 0.0;
        float hi = max(p.y, 0.0);
        [loop]
        for (int i = 0; i < 16; i++) {
            float mid = (lo + hi) * 0.5;
            float3 t = cs_oklab_to_linear(cs_polar_to_lab(float3(p.x, mid, p.z)));
            if (cs_in_gamut(t)) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        lin = cs_oklab_to_linear(cs_polar_to_lab(float3(p.x, lo, p.z)));
    }
    return lin;
}

// sRGB → 色空間の値
float3 cs_to_space(float3 c, float space) {
    float3 r = c;
    if (space > 8.5) {
        r = cs_rgb_to_hwb(c);
    } else if (space > 7.5) {
        r = cs_linear_to_xyz(cs_to_linear(c));
    } else if (space > 6.5) {
        r = cs_lab_to_polar(cs_linear_to_oklab(cs_to_linear(c)));
    } else if (space > 5.5) {
        r = cs_lab_to_polar(cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c))));
    } else if (space > 4.5) {
        r = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c)));
    } else if (space > 3.5) {
        r = cs_rgb_to_hsl(c);
    } else if (space > 2.5) {
        r = cs_rgb_to_hsv(c);
    } else if (space > 1.5) {
        r = cs_linear_to_oklab(cs_to_linear(c));
    } else if (space > 0.5) {
        r = cs_to_linear(c);
    }
    return r;
}

// 色空間の値 → sRGB（0〜1）。Oklch だけは C を下げて sRGB に収め、ほかは切り詰める
float3 cs_from_space(float3 v, float space) {
    float3 r = saturate(v);
    if (space > 8.5) {
        r = saturate(cs_hwb_to_rgb(v));
    } else if (space > 7.5) {
        r = cs_to_srgb(cs_xyz_to_linear(v));
    } else if (space > 6.5) {
        r = cs_to_srgb(cs_oklch_to_linear_fit(v));
    } else if (space > 5.5) {
        r = cs_to_srgb(cs_xyz_to_linear(cs_lab_to_xyz(cs_polar_to_lab(v))));
    } else if (space > 4.5) {
        r = cs_to_srgb(cs_xyz_to_linear(cs_lab_to_xyz(v)));
    } else if (space > 3.5) {
        r = saturate(cs_hsl_to_rgb(v));
    } else if (space > 2.5) {
        r = saturate(cs_hsv_to_rgb(v));
    } else if (space > 1.5) {
        r = cs_to_srgb(cs_oklab_to_linear(v));
    } else if (space > 0.5) {
        r = cs_to_srgb(v);
    }
    return r;
}

bool cs_is_polar(float space) {
    return (space > 2.5 && space < 4.5) || (space > 5.5 && space < 7.5) || space > 8.5;
}

// 色相を持たない（無彩色の）値か
bool cs_no_hue(float3 v, float space) {
    bool r = v.y < 0.0001;
    if (space > 8.5) {
        r = v.y + v.z > 0.9999;
    } else if (space > 6.5) {
        r = v.y < 0.0002;
    } else if (space > 5.5) {
        r = v.y < 0.05;
    }
    return r;
}

// 色空間の値どうしの補間。a0 / a1 は不透明度で、乗算済みのまま混ぜる（透明へ向かっても黒ずまない。CSS と同じ）。
// 色相のある色空間では色相だけは乗算せず、無彩色の側は相手の色相に合わせる。hue_long > 0.5 で長い方を回る。
// 戻り値の xyz は色空間の値（cs_from_space で sRGB に戻す）、w は不透明度
float4 cs_mix_values(float3 v0, float a0, float3 v1, float a1, float u, float space, float hue_long) {
    float a = lerp(a0, a1, u);
    float3 v = v0;
    if (cs_is_polar(space)) {
        float3 x0 = v0;
        float3 x1 = v1;
        if (cs_no_hue(x0, space)) {
            x0.x = x1.x;
        } else if (cs_no_hue(x1, space)) {
            x1.x = x0.x;
        }
        float dh = x1.x - x0.x;
        if (hue_long > 0.5) {
            if (dh > 0.0 && dh < 0.5) {
                dh = dh - 1.0;
            } else if (dh <= 0.0 && dh > -0.5) {
                dh = dh + 1.0;
            }
        } else {
            if (dh > 0.5) {
                dh = dh - 1.0;
            } else if (dh < -0.5) {
                dh = dh + 1.0;
            }
        }
        float2 yz = lerp(float2(x0.y, x0.z) * a0, float2(x1.y, x1.z) * a1, u);
        yz = a > 0.000001 ? yz / a : lerp(float2(x0.y, x0.z), float2(x1.y, x1.z), u);
        v = float3(frac(x0.x + dh * u + 1.0), yz.x, yz.y);
    } else {
        float3 pc = lerp(v0 * a0, v1 * a1, u);
        v = a > 0.000001 ? pc / a : lerp(v0, v1, u);
    }
    return float4(v, a);
}

// ストレートの sRGB 2 色を色空間で補間する。戻り値はストレートの sRGB と不透明度
float4 cs_mix(float4 c0, float4 c1, float u, float space, float hue_long) {
    float3 v0 = cs_to_space(c0.rgb, space);
    float3 v1 = cs_to_space(c1.rgb, space);
    float4 m = cs_mix_values(v0, c0.a, v1, c1.a, u, space, hue_long);
    return float4(cs_from_space(m.xyz, space), m.w);
}

// 色相を turns 周だけ回す。space: 3 HSV / 4 HSL / 6 LCh / 7 Oklch / 9 HWB（それ以外は HSV）。
// Oklch と LCh は明るさと C を保つ（Oklch は sRGB に無ければ C を下げる）
float3 cs_hue_shift(float3 c, float turns, float space) {
    float sp = cs_is_polar(space) ? space : 3.0;
    float3 v = cs_to_space(c, sp);
    v.x = frac(v.x + turns + 1.0);
    return cs_from_space(v, sp);
}

// 鮮やかさを k 倍にする。space: 0 sRGB（Rec.709 の輝度との間で伸ばす。従来の式）/ 3 HSV / 4 HSL / 6 LCh / 7 Oklch
float3 cs_scale_chroma(float3 c, float k, float space) {
    float3 r = c;
    if (cs_is_polar(space) && space < 8.5) {
        float3 v = cs_to_space(c, space);
        v.y = max(v.y * k, 0.0);
        r = cs_from_space(v, space);
    } else {
        float y = dot(c, float3(0.2126, 0.7152, 0.0722));
        r = saturate(lerp(float3(y, y, y), c, k));
    }
    return r;
}

// 明るさ（0〜1）。space: 0 sRGB（Rec.709 をガンマのまま。従来の式）/ 1 リニア（相対輝度 Y）/ 2・7 Oklab の L / 5・6 Lab の L / 3 HSV の V / 4 HSL の L
float cs_lightness(float3 c, float space) {
    float r = dot(c, float3(0.2126, 0.7152, 0.0722));
    if (space > 6.5 && space < 7.5) {
        r = cs_linear_to_oklab(cs_to_linear(c)).x;
    } else if (space > 4.5 && space < 6.5) {
        r = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c))).x / 100.0;
    } else if (space > 3.5 && space < 4.5) {
        r = cs_rgb_to_hsl(c).z;
    } else if (space > 2.5 && space < 3.5) {
        r = max(c.r, max(c.g, c.b));
    } else if (space > 1.5 && space < 2.5) {
        r = cs_linear_to_oklab(cs_to_linear(c)).x;
    } else if (space > 0.5 && space < 1.5) {
        r = dot(cs_to_linear(c), float3(0.2126729, 0.7151522, 0.0721750));
    }
    return r;
}

// CIEDE2000（Sharma, Wu, Dalal 2005）。Lab（D65）の値どうし。戻り値は ΔE00（0〜100 程度）
float cs_ciede2000(float3 lab1, float3 lab2) {
    float c1 = length(lab1.yz);
    float c2 = length(lab2.yz);
    float cb = (c1 + c2) * 0.5;
    float cb7 = pow(cb, 7.0);
    float g = 0.5 * (1.0 - sqrt(cb7 / (cb7 + 6103515625.0)));
    float a1p = lab1.y * (1.0 + g);
    float a2p = lab2.y * (1.0 + g);
    float c1p = length(float2(a1p, lab1.z));
    float c2p = length(float2(a2p, lab2.z));
    float h1p = (abs(a1p) + abs(lab1.z)) > 0.0 ? atan2(lab1.z, a1p) : 0.0;
    float h2p = (abs(a2p) + abs(lab2.z)) > 0.0 ? atan2(lab2.z, a2p) : 0.0;
    if (h1p < 0.0) {
        h1p = h1p + CS_TAU;
    }
    if (h2p < 0.0) {
        h2p = h2p + CS_TAU;
    }
    float dl = lab2.x - lab1.x;
    float dc = c2p - c1p;
    float dh = 0.0;
    float hbp = h1p + h2p;
    if (c1p * c2p > 0.0) {
        dh = h2p - h1p;
        if (dh > 3.14159265) {
            dh = dh - CS_TAU;
        } else if (dh < -3.14159265) {
            dh = dh + CS_TAU;
        }
        if (abs(h1p - h2p) > 3.14159265) {
            hbp = (h1p + h2p < CS_TAU) ? (h1p + h2p + CS_TAU) * 0.5 : (h1p + h2p - CS_TAU) * 0.5;
        } else {
            hbp = (h1p + h2p) * 0.5;
        }
    }
    float dhh = 2.0 * sqrt(c1p * c2p) * sin(dh * 0.5);
    float lbp = (lab1.x + lab2.x) * 0.5;
    float cbp = (c1p + c2p) * 0.5;
    float t = 1.0 - 0.17 * cos(hbp - 0.523598776) + 0.24 * cos(2.0 * hbp)
        + 0.32 * cos(3.0 * hbp + 0.104719755) - 0.20 * cos(4.0 * hbp - 1.099557429);
    float dtheta = 0.523598776 * exp(-pow((hbp * 57.29577951 - 275.0) / 25.0, 2.0));
    float cbp7 = pow(cbp, 7.0);
    float rc = 2.0 * sqrt(cbp7 / (cbp7 + 6103515625.0));
    float l50 = (lbp - 50.0) * (lbp - 50.0);
    float sl = 1.0 + 0.015 * l50 / sqrt(20.0 + l50);
    float sc = 1.0 + 0.045 * cbp;
    float sh = 1.0 + 0.015 * cbp * t;
    float rt = -sin(2.0 * dtheta) * rc;
    float tl = dl / sl;
    float tc = dc / sc;
    float th = dhh / sh;
    return sqrt(max(tl * tl + tc * tc + th * th + rt * tc * th, 0.0));
}

// 2 色の差。metric: 0 RGB / 1 YCbCr（BT.709 の色差だけ）/ 2 Oklab / 3 CIEDE2000。黒と白の差がおよそ 1
float cs_distance(float3 c0, float3 c1, float metric) {
    float r = length(c0 - c1) * 0.57735027;
    if (metric > 2.5) {
        float3 l0 = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c0)));
        float3 l1 = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c1)));
        r = cs_ciede2000(l0, l1) / 100.0;
    } else if (metric > 1.5) {
        r = length(cs_linear_to_oklab(cs_to_linear(c0)) - cs_linear_to_oklab(cs_to_linear(c1)));
    } else if (metric > 0.5) {
        float3 d = c0 - c1;
        float cb = dot(d, float3(-0.1146, -0.3854, 0.5));
        float cr = dot(d, float3(0.5, -0.4542, -0.0458));
        r = length(float2(cb, cr)) * 1.41421356;
    }
    return r;
}
// ==== colorspace.hlsl ここまで ====

// 影の色。sRGB（既定）は v2.2 までの lerp(c1, c2, t) のまま。
// ほかの色空間では Lua が c1 / c2 を先にその色空間へ変換して渡すので、混ぜてから sRGB へ戻す（2 色とも不透明）
float3 shadow_color(float t) {
    float3 grad = lerp(c1, c2, t);
    if (cs_space > 0.5) {
        grad = cs_from_space(cs_mix_values(c1, 1.0, c2, 1.0, t, cs_space, hue_long).xyz, cs_space);
    }
    return grad;
}

float4 ps_longshadow(float4 pos : SV_Position) : SV_Target {
    float4 base = InputTexture[uint2(pos.xy)];
    float4 result = base;
    int nstep = (int)ns;
    if (nstep <= 0 || l <= 0.0) {
        return result;
    }

    int tw = (int)tex_w;
    int th = (int)tex_h;
    float inv_l = 1.0 / max(l, 1e-3);
    // 最初に当たった段の t。色はループを出てから 1 回だけ求める（v2.3。色空間の式をループの中の
    // 2 か所に展開すると fxc で 39 ms → 430 ms に重くなった。1 か所にして 115 ms）。-1 は当たらなかった印
    float hit_t = -1.0;

    // mode < 0.5: 角度ファン（拡散・0）。各特徴が dir 中心の扇を持ち回転に剛体追従
    // mode >= 0.5: アフィン掃引（負角＝収束）。edge_a/b は s_top/s_bot
    if (mode < 0.5) {
        int nph = (int)nphi;
        if (nph < 1) {
            nph = 1;
        }
        float base_ang = atan2(dir.y, dir.x);
        // 上辺（edge_a）は +n の側。n は dir を -90 度回した向き（Angle=0 で画面の上）なので、
        // 上辺は角度を減らす側、下辺は増やす側へ開く。v2.1 は逆で、拡散だけ上辺が画面の下を開いていた
        float lo = radians(-edge_a);
        float hi = radians(edge_b);
        for (int i = 1; i <= nstep; i++) {
            float d = (float)i;
            float t = d * inv_l;
            for (int p = 0; p <= nph; p++) {
                float u = (float)p / (float)nph;
                float ph = base_ang + lerp(lo, hi, u);
                float2 ray = float2(cos(ph), sin(ph));
                int2 ip = int2(floor(pos.xy - ray * d + 0.5));
                if (ip.x < 0 || ip.y < 0 || ip.x >= tw || ip.y >= th) {
                    continue;
                }
                float4 sample = InputTexture[uint2(ip)];
                if (sample.a > 0.01) {
                    hit_t = t;
                    break;
                }
            }
            if (hit_t >= 0.0) {
                break;
            }
        }
    } else {
        float2 rel = pos.xy - center;
        float a = dot(rel, dir);
        float b = dot(rel, n);
        float inv_hw2 = 0.5 / max(half_w, 1e-3);
        float st = edge_a;
        float sb = edge_b;

        for (int i = 1; i <= nstep; i++) {
            float t = (float)i / (float)nstep;
            float k = 1.0 + (st + sb) * t * inv_hw2;
            if (k < 1e-3) {
                break;
            }
            float m = 0.5 * (st - sb) * t;
            float2 src = center + dir * (a - l * t) + n * ((b - m) / k);
            int2 ip = int2(floor(src + 0.5));
            if (ip.x < 0 || ip.y < 0 || ip.x >= tw || ip.y >= th) {
                continue;
            }
            float4 sample = InputTexture[uint2(ip)];
            if (sample.a > 0.01) {
                hit_t = t;
                break;
            }
        }
    }
    if (hit_t < 0.0) {
        return result;
    }
    float3 grad = shadow_color(hit_t);
    float aa = (trp > 0.5) ? ((1.0 - hit_t) * alpha) : alpha;
    return float4(grad * aa, aa);
}
]]

--[[pixelshader@ps_longshadow_mix:
Texture2D t0 : register(t0);
Texture2D t1 : register(t1);

cbuffer constant0 : register(b0) {
    float2 offset;
};

float4 ps_longshadow_mix(float4 pos : SV_Position) : SV_Target {
    float4 c0 = t0[uint2(pos.xy)];
    float4 c1 = t1[uint2(pos.xy - offset)];
    if (pos.x < offset.x || pos.y < offset.y) {
        return c0;
    }
    return float4(c0 * (1.0 - c1.a) + c1);
}
]]

local length = length or 0
local blur = blur or 0
if length <= 0 then
  return
end

local is_grad = (use_grad == 1 or use_grad == true)
local is_fade = (fade_by_dist == 1 or fade_by_dist == true)
local is_sym = (edge_symmetric == 1 or edge_symmetric == true)
local is_shadow_only = (shadow_only == 1 or shadow_only == true)
local is_fix_rot = (fix_rotate == 1 or fix_rotate == true)
local is_flat = (flat == 1 or flat == true)

obj.copybuffer("cache:_longshadow_h_org", "obj")

local c1 = color_start
local c2 = color_end
if not is_grad then
  c2 = c1
end
local r1, g1, b1 = RGB(c1)
local r2, g2, b2 = RGB(c2)
-- シェーダーへ渡す 2 色（0〜1）。sRGB（既定）は v2.2 までと同じ値
local s1x, s1y, s1z = r1 / 255, g1 / 255, b1 / 255
local s2x, s2y, s2z = r2 / 255, g2 / 255, b2 / 255

-- v2.3: 色空間・色相経路を足した。sRGB 以外では 2 色を先にその色空間へ変換して渡し、
-- シェーダーで混ぜてから戻す（共有部品 EffectUtils_ColorSpace.lua / colorspace.hlsl）。
-- グラデーションが OFF なら同じ色どうしなので sRGB のまま（往復の誤差も出さない）
local cs_space = math.floor((tonumber(color_space) or 0) + 0.5)
if not is_grad then
  cs_space = 0
end
local cs_long = 0
if cs_space ~= 0 then
  cs_long = (math.floor((tonumber(hue_path) or 0) + 0.5) == 1) and 1 or 0
  local cs = require("EffectUtils_ColorSpace")
  s1x, s1y, s1z = cs.to_space(s1x, s1y, s1z, cs_space)
  s2x, s2y, s2z = cs.to_space(s2x, s2y, s2z, cs_space)
end

local ang = angle
if is_fix_rot then
  ang = angle - obj.rz
end
local rad = math.rad(ang)
local dx = math.cos(rad)
local dy = math.sin(rad)
-- Angle=0 で n=(0,-1)=画面上。上辺の外側は +n
local nx = math.sin(rad)
local ny = -math.cos(rad)

local et = math.max(-80, math.min(80, edge_top or 0))
local eb = math.max(-80, math.min(80, edge_bottom or 0))
if is_sym then
  eb = et
end

local len = math.max(0, length)
local has_spread = (math.abs(et) > 1e-6) or (math.abs(eb) > 1e-6)
-- 負角を含むときは逆台形用アフィン、それ以外は角度ファン（回転に剛体追従）
local use_affine = (et < -1e-6) or (eb < -1e-6)

local orig_w, orig_h = obj.w, obj.h
if orig_w < 1 or orig_h < 1 then
  return
end

local max_w, max_h = obj.getinfo("image_max")
if type(max_w) ~= "number" or max_w < 1 then max_w = 16384 end
if type(max_h) ~= "number" or max_h < 1 then max_h = 16384 end

local hw0, hh0 = orig_w * 0.5, orig_h * 0.5
local corners = {
  {-hw0, -hh0}, {hw0, -hh0}, {hw0, hh0}, {-hw0, hh0},
}
local min_x, max_x = -hw0, hw0
local min_y, max_y = -hh0, hh0

local half_w = 0.5 * (math.abs(nx) * orig_w + math.abs(ny) * orig_h)
if half_w < 1 then
  half_w = 1
end
local s_top = len * math.tan(math.rad(et))
local s_bot = len * math.tan(math.rad(eb))

local function aabb_include(x, y)
  if x < min_x then min_x = x end
  if x > max_x then max_x = x end
  if y < min_y then min_y = y end
  if y > max_y then max_y = y end
end

if use_affine then
  local k1 = 1.0 + (s_top + s_bot) / (2.0 * half_w)
  local m1 = 0.5 * (s_top - s_bot)
  if k1 > 64 then k1 = 64 elseif k1 < -64 then k1 = -64 end
  for i = 1, 4 do
    local cx, cy = corners[i][1], corners[i][2]
    local a = cx * dx + cy * dy
    local bb = cx * nx + cy * ny
    local a2 = a + len
    local b2 = bb * k1 + m1
    aabb_include(a2 * dx + b2 * nx, a2 * dy + b2 * ny)
  end
else
  -- 扇の端・中心方向へ length 押し出し（上辺は角度を減らす側。シェーダーの lo / hi と同じ向き）
  local lo = rad - math.rad(et)
  local hi = rad + math.rad(eb)
  local angles = {rad, lo, hi}
  local two_pi = math.pi * 2
  local function norm_a(a)
    while a < -math.pi do a = a + two_pi end
    while a > math.pi do a = a - two_pi end
    return a
  end
  local lo_n, hi_n = norm_a(lo), norm_a(hi)
  local span = hi - lo
  if span < 0 then span = span + two_pi end
  for _, axis in ipairs({0, math.pi * 0.5, math.pi, -math.pi * 0.5}) do
    local d = norm_a(axis - lo_n)
    if d < 0 then d = d + two_pi end
    if d <= span + 1e-6 then
      angles[#angles + 1] = axis
    end
  end
  for _, ph in ipairs(angles) do
    local ux, uy = math.cos(ph), math.sin(ph)
    for i = 1, 4 do
      local cx, cy = corners[i][1], corners[i][2]
      aabb_include(cx + len * ux, cy + len * uy)
    end
  end
end

local left = math.max(0, math.ceil(-min_x - hw0))
local right = math.max(0, math.ceil(max_x - hw0))
local up = math.max(0, math.ceil(-min_y - hh0))
local down = math.max(0, math.ceil(max_y - hh0))

if blur > 0 then
  local blur_pad = math.ceil(blur + 1)
  left = left + blur_pad
  right = right + blur_pad
  up = up + blur_pad
  down = down + blur_pad
end

-- v2.3.1: フィルタオブジェクト（画面全体）では大きさを変えられない（変えると different frame buffer size）。
-- 広げずに画面の中へ描く（はみ出す影は切れる）。強化デバッグ edg_1 の EDG-3835
local is_filter_obj = obj.getinfo("filter") and true or false
if is_filter_obj then
  left, right, up, down = 0, 0, 0, 0
end

-- CreateRenderTargetView(E_INVALIDARG) 防止
local avail_w = math.max(0, math.floor(max_w - orig_w))
local avail_h = math.max(0, math.floor(max_h - orig_h))
local need_w = left + right
local need_h = up + down
local scale = 1
if need_w > avail_w and need_w > 0 then
  scale = math.min(scale, avail_w / need_w)
end
if need_h > avail_h and need_h > 0 then
  scale = math.min(scale, avail_h / need_h)
end
if scale < 1 then
  left = math.max(0, math.floor(left * scale))
  right = math.max(0, math.floor(right * scale))
  up = math.max(0, math.floor(up * scale))
  down = math.max(0, math.floor(down * scale))
  len = len * scale
  s_top = s_top * scale
  s_bot = s_bot * scale
  while left + right > avail_w and (left > 0 or right > 0) do
    if left >= right and left > 0 then left = left - 1 else right = math.max(0, right - 1) end
  end
  while up + down > avail_h and (up > 0 or down > 0) do
    if up >= down and up > 0 then up = up - 1 else down = math.max(0, down - 1) end
  end
end

if left > 0 or right > 0 or up > 0 or down > 0 then
  obj.effect("領域拡張", "上", up, "下", down, "右", right, "左", left)
end

local center_x = left + orig_w * 0.5
local center_y = up + orig_h * 0.5

local nstep = math.max(1, math.ceil(len))
local nphi = 1
if has_spread and not use_affine then
  local span_deg = math.abs(et) + math.abs(eb)
  nphi = math.max(1, math.min(72, math.ceil(span_deg)))
end
if use_affine and has_spread then
  local tan_m = math.max(math.abs(math.tan(math.rad(et))), math.abs(math.tan(math.rad(eb))))
  local sub = math.max(1, math.min(4, math.ceil(tan_m)))
  nstep = math.min(math.ceil(len * sub), 6000)
end

local trp_f = is_fade and 1 or 0
local mode_f = use_affine and 1 or 0
local edge_a = use_affine and s_top or et
local edge_b = use_affine and s_bot or eb

if len > 0 then
  obj.pixelshader("ps_longshadow", "object", "object", {
    len, alpha, trp_f, mode_f,
    dx, dy, nx, ny,
    center_x, center_y, half_w, nstep,
    nphi, edge_a, edge_b, obj.w,
    obj.h, 0, 0, 0,
    s1x, s1y, s1z, 0,
    s2x, s2y, s2z, 0,
    cs_space, cs_long,
  })
end

-- フラットは拡散時スキップ（シルエット無視のため）
if is_flat and len > 0 and not has_spread then
  -- 原作 LongShadow（こんにゃくねこ, CC0）のフラット部分と同じ。原作者はこの部分を
  -- Aodaruma 氏の FlatShadow (https://github.com/Aodaruma/FlatShadow) に影響を受けたと書いている
  -- 本体のグラデーションで塗り直すので、ここでは 色空間・色相経路 は効かない（本体の 色補間 の既定 RGB のまま）
  if obj.num > 1 then
    obj.effect("グラデーション", "color", c1, "color2", c2, "角度", ang - 90, "幅", len)
  else
    if dy < 0 then
      obj.effect("グラデーション", "color", c1, "color2", c2, "角度", 180, "幅", len, "中心Y", -dy * len / 4)
    else
      obj.effect("グラデーション", "color", c1, "color2", c2, "角度", 0, "幅", len, "中心Y", -dy * len / 4)
    end
  end
end

if blur > 0 then
  local dist = math.min(math.max(math.floor(0.5 + (blur_dist or 1)), 0), 2)
  local ok, basic_s = pcall(require, "Basic_S")
  if ok and basic_s and basic_s.effect and basic_s.effect.prec_blur then
    basic_s.effect.prec_blur(blur, blur, 0, true, dist)
  else
    local w_before, h_before = obj.w, obj.h
    if is_filter_obj then
      obj.effect("ぼかし", "範囲", blur, "サイズ固定", 1)
    else
      obj.effect("ぼかし", "範囲", blur)
    end
    left = left + (obj.w - w_before) * 0.5
    right = right + (obj.w - w_before) * 0.5
    up = up + (obj.h - h_before) * 0.5
    down = down + (obj.h - h_before) * 0.5
  end
end

if not is_shadow_only then
  obj.pixelshader("ps_longshadow_mix", "object", {"object", "cache:_longshadow_h_org"}, {left, up})
end

obj.cx = obj.cx + (left - right) / 2
obj.cy = obj.cy + (up - down) / 2
